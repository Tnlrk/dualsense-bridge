<UserControl x:Class="DualSenseBridge.UI.TriggerEditorView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:loc="clr-namespace:DualSenseBridge.Localization">
    <UserControl.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </UserControl.Resources>

    <StackPanel>
        <TextBlock x:Name="Title" Style="{StaticResource H2}" Margin="0,0,0,10"/>

        <Border Background="#1E2026" CornerRadius="9" Padding="2">
            <UniformGrid Rows="1">
                <RadioButton x:Name="KindOff" Style="{StaticResource Segment}" Content="{Binding [tr_off], Source={x:Static loc:Loc.Instance}}"/>
                <RadioButton x:Name="KindResistance" Style="{StaticResource Segment}" Content="{Binding [tr_resistance], Source={x:Static loc:Loc.Instance}}"/>
                <RadioButton x:Name="KindWeapon" Style="{StaticResource Segment}" Content="{Binding [tr_weapon], Source={x:Static loc:Loc.Instance}}"/>
                <RadioButton x:Name="KindVibration" Style="{StaticResource Segment}" Content="{Binding [tr_vibration], Source={x:Static loc:Loc.Instance}}"/>
            </UniformGrid>
        </Border>

        <TextBlock x:Name="Hint" Style="{StaticResource Dim}" Margin="2,10,0,6" MinHeight="34"/>

        <Grid x:Name="StartRow" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [tr_start], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
            <Slider x:Name="Start" Grid.Column="1" Minimum="0" Maximum="9"/>
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Start}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="EndRow" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [tr_end], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
            <Slider x:Name="End" Grid.Column="1" Minimum="3" Maximum="8"/>
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=End}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="StrengthRow" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [tr_strength], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
            <Slider x:Name="Strength" Grid.Column="1" Minimum="1" Maximum="8"/>
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Strength}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
        <Grid x:Name="FrequencyRow" Margin="0,2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="110"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="34"/>
            </Grid.ColumnDefinitions>
            <TextBlock Text="{Binding [tr_frequency], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
            <Slider x:Name="Frequency" Grid.Column="1" Minimum="5" Maximum="100"/>
            <TextBlock Grid.Column="2" Text="{Binding Value, ElementName=Frequency}" HorizontalAlignment="Right" VerticalAlignment="Center"/>
        </Grid>
    </StackPanel>
</UserControl>
