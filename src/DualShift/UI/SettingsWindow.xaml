<Window x:Class="DualShift.UI.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:ui="clr-namespace:DualShift.UI"
        xmlns:loc="clr-namespace:DualShift.Localization"
        Title="DualShift" Width="1180" Height="960" MinWidth="960" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBg}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        UseLayoutRounding="True">
    <Window.Resources>
        <ResourceDictionary Source="Theme.xaml"/>
    </Window.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
        <Grid Margin="16,14,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Záhlaví: název, stav ovladačů, jazyk, nápověda -->
            <DockPanel Margin="8,4,8,10">
                <StackPanel DockPanel.Dock="Left" VerticalAlignment="Center">
                    <TextBlock Text="DualShift" Style="{StaticResource H1}"/>
                    <TextBlock Text="{Binding [sw_subtitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource Dim}" FontSize="13"/>
                </StackPanel>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center" Margin="12,0,0,0">
                    <Border Background="{StaticResource CardBg}" BorderBrush="{StaticResource CardBorder}" BorderThickness="1"
                            CornerRadius="10" Padding="2" Margin="8,0,0,0">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="LangCs" Style="{StaticResource Segment}" GroupName="lang" Content="CZ" MinWidth="40" ToolTip="Čeština"/>
                            <RadioButton x:Name="LangEn" Style="{StaticResource Segment}" GroupName="lang" Content="EN" MinWidth="40" ToolTip="English"/>
                        </StackPanel>
                    </Border>
                    <Button x:Name="HelpButton" Margin="8,0,0,0" Padding="14,8">
                        <StackPanel Orientation="Horizontal">
                            <Border Width="18" Height="18" CornerRadius="9" Background="{StaticResource Accent}" Margin="0,0,8,0">
                                <TextBlock Text="?" FontWeight="Bold" FontSize="12" Foreground="White"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"/>
                            </Border>
                            <TextBlock Text="{Binding [sw_help], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
                <WrapPanel x:Name="StatusChips" HorizontalAlignment="Right" VerticalAlignment="Center"/>
            </DockPanel>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="400"/>
                </Grid.ColumnDefinitions>

                <!-- Levý sloupec -->
                <StackPanel>
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <DockPanel>
                                <StackPanel x:Name="ControllerPicker" DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top"/>
                                <TextBlock Text="{Binding [sw_testTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            </DockPanel>
                            <TextBlock Style="{StaticResource Dim}" Text="{Binding [sw_testHint], Source={x:Static loc:Loc.Instance}}"/>
                            <Border x:Name="ImageHost" Height="430" Margin="0,10,0,0">
                                <Image x:Name="ControllerImage" Stretch="Fill" RenderOptions.BitmapScalingMode="HighQuality"/>
                            </Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding [sw_triggersTitle], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource H2}" Margin="0,0,0,4"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,0,0,14" Text="{Binding [sw_triggersHint], Source={x:Static loc:Loc.Instance}}"/>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="28"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <ui:TriggerEditorView x:Name="LeftTrigger" Header="{Binding [sw_leftTrigger], Source={x:Static loc:Loc.Instance}}"/>
                                <ui:TriggerEditorView x:Name="RightTrigger" Grid.Column="2" Header="{Binding [sw_rightTrigger], Source={x:Static loc:Loc.Instance}}"/>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Pravý sloupec -->
                <StackPanel Grid.Column="1">
                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding [sw_vibration], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="Vibration" Style="{StaticResource Toggle}" Content="{Binding [sw_vibFromGame], Source={x:Static loc:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,0,52,10" Text="{Binding [sw_vibHint], Source={x:Static loc:Loc.Instance}}"/>
                            <CheckBox x:Name="TriggerRumble" Style="{StaticResource Toggle}" Content="{Binding [sw_trigRumble], Source={x:Static loc:Loc.Instance}}"/>
                            <CheckBox x:Name="TriggerRumbleOnlyPressed" Style="{StaticResource Toggle}" Margin="18,5,0,5"
                                      Content="{Binding [sw_trigRumbleOnly], Source={x:Static loc:Loc.Instance}}"/>
                            <TextBlock Style="{StaticResource Dim}" Margin="0,2,52,12" Text="{Binding [sw_trigRumbleHint], Source={x:Static loc:Loc.Instance}}"/>
                            <Button x:Name="TestRumble" Content="{Binding [sw_testVib], Source={x:Static loc:Loc.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding [sw_lightbar], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="LightbarOn" Style="{StaticResource Toggle}" Content="{Binding [sw_lightOn], Source={x:Static loc:Loc.Instance}}"/>

                            <StackPanel x:Name="LightbarControls" Margin="0,8,0,0">
                                <DockPanel Margin="0,0,0,12">
                                    <Border x:Name="ColorPreview" DockPanel.Dock="Right" Width="64" Height="30" CornerRadius="8"
                                            BorderBrush="#454B57" BorderThickness="1" Margin="10,0,0,0"/>
                                    <WrapPanel x:Name="Swatches" VerticalAlignment="Center"/>
                                </DockPanel>

                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [sw_hue], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                    <Slider x:Name="Hue" Grid.Column="1" Style="{StaticResource GradientSlider}"
                                            Minimum="0" Maximum="360" Background="{StaticResource HueBrush}"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [sw_saturation], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                    <Slider x:Name="Saturation" Grid.Column="1" Style="{StaticResource GradientSlider}" Minimum="0" Maximum="100"/>
                                </Grid>
                                <Grid Margin="0,2">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="80"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="44"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="{Binding [sw_brightness], Source={x:Static loc:Loc.Instance}}" VerticalAlignment="Center" Foreground="{StaticResource TextDim}"/>
                                    <Slider x:Name="Brightness" Grid.Column="1" Minimum="1" Maximum="100"/>
                                    <TextBlock Grid.Column="2" HorizontalAlignment="Right" VerticalAlignment="Center"
                                               Text="{Binding Value, ElementName=Brightness, StringFormat={}{0} %}"/>
                                </Grid>
                            </StackPanel>

                            <CheckBox x:Name="LowBattery" Style="{StaticResource Toggle}" Margin="0,12,0,5"
                                      Content="{Binding [sw_lowBattery], Source={x:Static loc:Loc.Instance}}"/>
                            <CheckBox x:Name="PlayerLeds" Style="{StaticResource Toggle}" Content="{Binding [sw_playerLeds], Source={x:Static loc:Loc.Instance}}"/>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource Card}">
                        <StackPanel>
                            <TextBlock Text="{Binding [sw_other], Source={x:Static loc:Loc.Instance}}" Style="{StaticResource H2}"/>
                            <CheckBox x:Name="Touchpad" Style="{StaticResource Toggle}" Content="{Binding [sw_touchpad], Source={x:Static loc:Loc.Instance}}"/>
                            <CheckBox x:Name="Notifications" Style="{StaticResource Toggle}" Content="{Binding [sw_notifications], Source={x:Static loc:Loc.Instance}}"/>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Grid>
        </Grid>
    </ScrollViewer>
</Window>
