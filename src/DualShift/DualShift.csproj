<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <UseWPF>true</UseWPF>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>DualShift</AssemblyName>
    <RootNamespace>DualShift</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>Assets\app.ico</ApplicationIcon>
    <Version>1.0.0</Version>
    <Product>DualShift</Product>
    <Description>DualShift – PS5 to Xbox for PC</Description>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SatelliteResourceLanguages>en</SatelliteResourceLanguages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="HidSharp" Version="2.6.4" />
    <PackageReference Include="Nefarius.Drivers.HidHide" Version="3.4.0" />
    <PackageReference Include="Nefarius.ViGEm.Client" Version="1.21.256" />
  </ItemGroup>

  <ItemGroup>
    <!-- Oficiální instalátory ovladačů (BSD-3, nefarius) přibalené do exe pro instalaci na jiném PC. -->
    <EmbeddedResource Include="Redist\ViGEmBus_Setup.exe" LogicalName="Redist.ViGEmBus_Setup.exe" />
    <EmbeddedResource Include="Redist\HidHide_Setup.exe" LogicalName="Redist.HidHide_Setup.exe" />
    <EmbeddedResource Include="Assets\dualsense.png" LogicalName="Assets.dualsense.png" />
    <EmbeddedResource Include="Assets\app.ico" LogicalName="Assets.app.ico" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="DualShift.Tests" />
    <!-- WinForms (lišta) a WPF (okno nastavení) mají stejně pojmenované typy – usingy se píšou ručně. -->
    <Using Remove="System.Windows.Forms" />
    <Using Remove="System.Drawing" />
    <Using Include="System.IO" />
  </ItemGroup>

</Project>
